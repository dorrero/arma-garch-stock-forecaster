# Copy this file to .env and fill in real values, or `export` these
# directly in your shell before running manage.py. Never commit .env.

# Django's cryptographic signing key (sessions, CSRF tokens, etc).
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Set to False outside local development.
DJANGO_DEBUG=True

# IEX Cloud API token, used for the live stock quote lookup in quotes/views.py.
# Get one at https://iexcloud.io/ (free tier available).
IEX_API_TOKEN=
